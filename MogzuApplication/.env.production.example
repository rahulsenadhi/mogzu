# Production build — copy to .env.production before `npm run build`.
# Only VITE_* vars are baked into the static bundle. Never put secrets here.

# Supabase (same project as dev, or a dedicated prod project)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Public site URL (used in auth redirects and absolute links)
VITE_APP_URL=https://mogzu.com
VITE_APP_ENV=production

# Razorpay public key only (secret stays in Supabase Edge Function secrets)
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_here

# WhatsApp enquiry button — country code + number, no + (e.g. 919876543210)
VITE_MOGZU_WHATSAPP=91XXXXXXXXXX

# Optional: Cloudflare Turnstile site key for public forms
# VITE_TURNSTILE_SITE_KEY=
